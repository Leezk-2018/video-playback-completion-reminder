{
  "manifest_version": 3,
  "name": "视频完播提醒",
  "description": "监测网页视频播放，控制播放倍速，并在结束时发送系统或 QQ 邮箱提醒。",
  "version": "1.2.0",
  "permissions": [
    "activeTab",
    "notifications",
    "scripting",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "视频完播提醒",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
